# FNU Web Portal — production environment template.
# Copy to .env.production, fill in real values, chmod 600, NEVER commit.
#
# Every placeholder ending in `-REPLACE` will be rejected by the backend's
# `Settings.validate_secrets` when ENVIRONMENT=production. Use
# scripts/generate_secrets.sh to generate the cryptographic secrets.

# ----- Core -----
ENVIRONMENT=production
LOG_FORMAT=json
PUBLIC_APP_URL=https://portal.fnu.ac.fj

# ----- PostgreSQL -----
# The docker-compose.prod.yml creates the DB using these values, then the
# application connects with an unprivileged role created in docs/DEPLOYMENT.md.
POSTGRES_USER=fnu
POSTGRES_PASSWORD=REPLACE-with-strong-random-32-chars
POSTGRES_DB=fnu_portal
DATABASE_URL=postgresql+asyncpg://fnu_app:REPLACE-with-app-role-password@postgres:5432/fnu_portal

# ----- Auth / sessions -----
JWT_SECRET=REPLACE-with-64-char-random
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
NEXTAUTH_SECRET=REPLACE-with-64-char-random
NEXTAUTH_URL=https://portal.fnu.ac.fj

# ----- Banner (Ellucian) -----
BANNER_MODE=live
BANNER_API_URL=https://banner.fnu.ac.fj/ethos
BANNER_API_KEY=REPLACE-with-banner-bearer-token
BANNER_TIMEOUT_SECONDS=10
BANNER_CACHE_TTL_SECONDS=900
BANNER_RATE_LIMIT_PER_SEC=20

# ----- Payment gateways -----
PAYMENTS_MODE=live
MPAISA_MERCHANT_ID=REPLACE
MPAISA_SECRET=REPLACE
MPAISA_API_URL=https://api.mpaisa.vodafone.com.fj
MPAISA_CALLBACK_URL=https://portal.fnu.ac.fj/api/payments/callback/mpaisa
MYCASH_MERCHANT_ID=REPLACE
MYCASH_SECRET=REPLACE
MYCASH_API_URL=https://api.digicel.com.fj/mycash
MYCASH_CALLBACK_URL=https://portal.fnu.ac.fj/api/payments/callback/mycash

# ----- AI chatbot -----
CHATBOT_MODE=live
OPENROUTER_API_KEY=REPLACE-with-sk-or-v1-token
OPENROUTER_MODEL=anthropic/claude-sonnet-4
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
CHATBOT_MAX_MESSAGE_CHARS=2000
CHATBOT_MAX_HISTORY_TURNS=50

# ----- Notifications -----
NOTIFICATIONS_MODE=live
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=REPLACE-with-sendgrid-api-key
SMTP_FROM=noreply@portal.fnu.ac.fj
SMTP_USE_TLS=true
SMS_PROVIDER=vodafone
SMS_API_URL=https://api.vodafone.com.fj/sms/v1/send
SMS_API_KEY=REPLACE-with-vodafone-sms-key
SMS_FROM=FNU

# ----- ID card / QR signing -----
ID_CARD_SECRET=REPLACE-with-64-char-random
ID_CARD_VALIDITY_DAYS=365

# ----- Profile photos -----
PROFILE_PHOTO_MAX_BYTES=2097152
PROFILE_PHOTO_TARGET_SIZE=400

# ----- CORS / embed -----
CORS_ORIGINS=["https://portal.fnu.ac.fj"]
NEXT_PUBLIC_EMBED_ALLOWED_ORIGINS=https://www.fnu.ac.fj

# ----- KPI scheduler -----
KPI_SCHEDULER_ENABLED=true
KPI_COMPUTE_INTERVAL_MINUTES=60
