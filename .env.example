# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://fnu:fnu_dev_password@localhost:5432/fnu_portal

# JWT
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Next.js / next-auth
NEXTAUTH_SECRET=change-me-to-a-random-64-char-string
NEXTAUTH_URL=http://localhost:3000

# OpenRouter (AI chatbot)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=anthropic/claude-sonnet-4
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
# CHATBOT_MODE=stub for local dev/CI (deterministic FAQ-only replies, no LLM call);
# set to live in production with OPENROUTER_API_KEY populated.
CHATBOT_MODE=stub
CHATBOT_MAX_MESSAGE_CHARS=2000
CHATBOT_MAX_HISTORY_TURNS=50

# Environment (development | production)
ENVIRONMENT=development

# Banner (mock | live)
BANNER_MODE=mock
BANNER_API_URL=
BANNER_API_KEY=
BANNER_TIMEOUT_SECONDS=10
BANNER_CACHE_TTL_SECONDS=900

# Payment gateways
# PAYMENTS_MODE=stub for local dev/CI; set to live in production (enforced by validator)
PAYMENTS_MODE=stub
MPAISA_MERCHANT_ID=
MPAISA_SECRET=
MPAISA_API_URL=https://sandbox.mpaisa.vodafone.com.fj/api
MPAISA_CALLBACK_URL=http://localhost/api/payments/callback/mpaisa
MYCASH_MERCHANT_ID=
MYCASH_SECRET=
MYCASH_API_URL=https://sandbox.digicel.com.fj/mycash/api
MYCASH_CALLBACK_URL=http://localhost/api/payments/callback/mycash

# Email (Mailtrap sandbox)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@portal.fnu.ac.fj

# SMS (stub in dev)
SMS_PROVIDER=stub
