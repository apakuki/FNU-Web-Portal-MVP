# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://fnu:fnu_dev_password@localhost:5432/fnu_portal

# JWT
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Next.js / next-auth
NEXTAUTH_SECRET=change-me-to-a-random-64-char-string
NEXTAUTH_URL=http://localhost:3000

# OpenRouter (AI chatbot)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Environment (development | production)
ENVIRONMENT=development

# Banner
BANNER_MODE=mock

# Payment gateways (sandbox)
MPAISA_MERCHANT_ID=
MPAISA_SECRET=
MPAISA_CALLBACK_URL=http://localhost/api/payments/callback/mpaisa
MYCASH_MERCHANT_ID=
MYCASH_SECRET=
MYCASH_CALLBACK_URL=http://localhost/api/payments/callback/mycash

# Email (Mailtrap sandbox)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@portal.fnu.ac.fj

# SMS (stub in dev)
SMS_PROVIDER=stub
